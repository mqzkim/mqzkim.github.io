---
import ComingSoonPage from '../../components/ComingSoonPage.astro';

const title = '사업자용 랜딩 문구 템플릿 체크리스트 준비 중 | 사업자 도구 모음';
const description = '상품 소개, 혜택, 신뢰 요소, CTA가 빠지지 않았는지 확인하는 무료 체크리스트를 준비 중입니다.';
---

<ComingSoonPage
  title={title}
  description={description}
  h1="사업자용 랜딩 문구 템플릿 체크리스트"
  body="상품 소개, 고객 문제, 핵심 혜택, 신뢰 요소, CTA 문구가 랜딩 페이지에 빠지지 않았는지 점검하는 체크리스트를 준비하고 있습니다."
  items={[
    '예정 항목: 한 줄 가치 제안, 대상 고객, 혜택, 증거, 문의/구매 CTA',
    '예정 출력: 랜딩 문구 작성 전 체크리스트와 예시 문장',
  ]}
  notice="참고용 도구이며 광고 성과·법률 문구·업종별 표시 의무 판단은 전문가 확인이 필요합니다."
/>
