---
import ComingSoonPage from '../../components/ComingSoonPage.astro';

const title = '견적서 항목 체크리스트 준비 중 | 사업자 도구 모음';
const description = '견적서에 빠지기 쉬운 항목과 조건을 제출 전 점검하는 무료 체크리스트를 준비 중입니다.';
---

<ComingSoonPage
  title={title}
  description={description}
  h1="견적서 항목 체크리스트"
  body="견적 금액, 작업 범위, 납기, 수정 횟수, 결제 조건처럼 빠지기 쉬운 항목을 제출 전 점검하는 체크리스트를 준비하고 있습니다."
  items={[
    '예정 항목: 공급 범위, 제외 범위, 일정, 세금/부가세, 결제 조건',
    '예정 출력: 복사 가능한 견적 전 점검 목록',
  ]}
  notice="참고용 도구이며 계약·세무·법률 판단은 전문가 확인이 필요합니다."
/>
