---
const title = '견적서 체크리스트 | 금액·범위·납기 제출 전 점검';
const description = '견적서를 보내기 전 작업 범위, 금액, 납기, 결제 조건, 수정 범위를 3분 안에 점검하는 무료 체크리스트입니다.';
const canonicalUrl = 'https://mqzkim.github.io/checklists/quote-checklist/';

const checklist = [
  {
    id: 'quote-scope',
    title: '작업 범위',
    items: [
      '작업 범위와 제외 범위를 함께 적었나요?',
      '최종 산출물 형식과 개수를 적었나요?',
      '고객이 제공해야 할 자료와 제공 기한을 적었나요?',
    ],
  },
  {
    id: 'quote-price',
    title: '금액·세금',
    items: [
      '총 견적 금액과 세부 항목별 금액을 분리했나요?',
      '부가세 포함/별도 여부를 표시했나요?',
      '추가 요청이 생길 때의 과금 기준을 적었나요?',
    ],
  },
  {
    id: 'quote-schedule',
    title: '일정·납기',
    items: [
      '착수 가능일, 중간 확인일, 최종 납기일을 적었나요?',
      '고객 피드백 지연 시 일정이 밀릴 수 있음을 적었나요?',
      '긴급 작업 또는 야간/주말 대응 비용을 구분했나요?',
    ],
  },
  {
    id: 'quote-payment',
    title: '결제 조건',
    items: [
      '선금/잔금 비율과 결제 기한을 적었나요?',
      '계좌, 세금계산서, 현금영수증 등 결제 처리 방식을 정했나요?',
      '취소·환불·중도 해지 조건을 적었나요?',
    ],
  },
  {
    id: 'quote-revision',
    title: '수정·검수',
    items: [
      '무료 수정 횟수와 수정 범위를 적었나요?',
      '검수 완료 기준과 승인 방식(메일/메신저 등)을 적었나요?',
      '원본 파일·소스·저작권 인도 범위를 구분했나요?',
    ],
  },
];

const copyTemplate = `견적 전 점검
- 작업 범위/제외 범위:
- 산출물 형식/개수:
- 공급 자료/기한:
- 견적 금액 및 부가세 포함 여부:
- 추가 요청 과금 기준:
- 착수일/중간 확인일/최종 납기:
- 결제 조건(선금/잔금/기한):
- 수정 횟수/범위:
- 검수 완료 기준:
- 취소·환불·권리 인도 조건:`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: '견적서 체크리스트',
  description,
  url: canonicalUrl,
  inLanguage: 'ko-KR',
  isAccessibleForFree: true,
};
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '홈', item: 'https://mqzkim.github.io/' },
    { '@type': 'ListItem', position: 2, name: '견적서 체크리스트', item: canonicalUrl },
  ],
};
---

<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="ko-KR" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    <style>
      :root { color-scheme: light; font-family: Pretendard, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; background: #f7f9fc; color: #172033; }
      body { margin: 0; background: linear-gradient(180deg, #fff 0%, #f4f8ff 54%, #edf4fb 100%); }
      a { color: #2458c7; text-decoration: none; }
      a:hover { text-decoration: underline; }
      .shell { width: min(1080px, calc(100% - 32px)); margin: 0 auto; }
      header { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 24px 0; }
      .brand { font-weight: 900; letter-spacing: -0.03em; }
      nav { display: flex; flex-wrap: wrap; gap: 12px; font-size: .95rem; }
      .hero { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(280px, .75fr); gap: 24px; align-items: stretch; padding: 48px 0 28px; }
      .eyebrow { color: #2458c7; font-weight: 900; margin: 0 0 10px; }
      h1 { font-size: clamp(2.25rem, 6vw, 4.4rem); line-height: 1; letter-spacing: -0.06em; margin: 0 0 18px; }
      .lead { color: #45526a; font-size: clamp(1.05rem, 2.1vw, 1.22rem); line-height: 1.75; margin: 0; }
      .card { background: rgba(255,255,255,.94); border: 1px solid rgba(75,105,170,.16); border-radius: 26px; box-shadow: 0 24px 70px rgba(40,70,120,.1); padding: 26px; }
      .notice { border-left: 4px solid #f0a43c; background: #fff8ed; color: #5e4520; line-height: 1.65; }
      .grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(300px, 360px); gap: 24px; align-items: start; padding-bottom: 64px; }
      .checklist { display: grid; gap: 16px; }
      .check-section h2, .card h2 { margin-top: 0; letter-spacing: -0.035em; }
      .check-section ul { display: grid; gap: 10px; padding: 0; list-style: none; }
      .check-section li { display: grid; grid-template-columns: auto 1fr; gap: 10px; align-items: start; color: #34415a; line-height: 1.65; }
      input[type="checkbox"] { width: 18px; height: 18px; margin-top: 4px; accent-color: #2458c7; }
      pre { white-space: pre-wrap; overflow-wrap: anywhere; border-radius: 18px; background: #14213d; color: #f8fafc; padding: 18px; line-height: 1.65; }
      .button { display: inline-flex; align-items: center; justify-content: center; border-radius: 999px; background: #1f3f8f; color: #fff; min-height: 46px; padding: 0 18px; font-weight: 900; }
      .related { display: grid; gap: 12px; }
      .related a { border: 1px solid #dce5f4; border-radius: 18px; background: #fff; padding: 15px; font-weight: 800; }
      footer { padding: 32px 0 48px; color: #68758c; }
      @media (max-width: 840px) { header, .hero, .grid { grid-template-columns: 1fr; } header { align-items: flex-start; flex-direction: column; } }
    </style>
  </head>
  <body>
    <div class="shell">
      <header>
        <a class="brand" href="/">사업자 도구 모음</a>
        <nav aria-label="주요 도구">
          <a href="/tools/vat-calculator">부가세 계산기</a>
          <a href="/tools/margin-calculator">마진율 계산기</a>
          <a href="/tools/wage-converter">인건비 계산기</a>
        </nav>
      </header>

      <main>
        <section class="hero">
          <div>
            <p class="eyebrow">무료 체크리스트 · 견적 전 누락 방지</p>
            <h1>견적서 항목 체크리스트</h1>
            <p class="lead">견적서를 보내기 전 3분 안에 빠진 조건을 확인하세요. 금액, 범위, 납기, 결제, 수정 조건을 한 화면에서 점검할 수 있습니다.</p>
          </div>
          <aside class="card notice" aria-label="참고용 고지">
            참고용 체크리스트이며 계약·세무·법률 판단은 전문가 확인이 필요합니다. 실제 계약서는 거래 조건과 업종에 맞춰 별도로 검토하세요.
          </aside>
        </section>

        <section class="grid" aria-label="견적서 체크리스트 본문">
          <div class="checklist" id="quote-checklist">
            {checklist.map((section) => (
              <article class="card check-section" id={section.id}>
                <h2>{section.title}</h2>
                <ul>
                  {section.items.map((item, index) => (
                    <li>
                      <input id={`${section.id}-${index + 1}`} type="checkbox" />
                      <label for={`${section.id}-${index + 1}`}>{item}</label>
                    </li>
                  ))}
                </ul>
              </article>
            ))}
          </div>

          <aside class="card">
            <h2>복사용 점검 템플릿</h2>
            <p class="lead">아래 문구를 복사해서 견적서 메모에 붙여넣기 후 비어 있는 항목을 채우세요.</p>
            <pre id="quote-copy-template">{copyTemplate}</pre>
            <a class="button" href="#quote-checklist">체크리스트로 돌아가기</a>
          </aside>
        </section>

        <section class="card" aria-label="관련 도구">
          <h2>견적 전 같이 확인할 도구</h2>
          <div class="related">
            <a href="/tools/vat-calculator">부가세 계산기로 공급가액/세액 확인하기</a>
            <a href="/tools/margin-calculator">마진율 계산기로 실제 남는 금액 확인하기</a>
            <a href="/tools/wage-converter">인건비 계산기로 작업 시간 비용 감 잡기</a>
          </div>
        </section>
      </main>

      <footer>
        <p>사업자 도구 모음 MVP · 입력값을 저장하지 않는 정적 무료 웹 도구를 목표로 합니다.</p>
      </footer>
    </div>
  </body>
</html>
